@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<section class="loans-page">
    <div class="loans-page__header">
        <div>
            <p class="eyebrow">Lending desk</p>
            <h1 class="mb-1">Loans</h1>
            <p class="text-muted mb-0">@Model.Count loans, newest first</p>
        </div>
        <a asp-action="Borrow" class="btn btn-primary loans-page__borrow"><span aria-hidden="true">＋</span> Borrow a book</a>
    </div>

    <div class="loan-summary" aria-label="Loan summary">
        <div class="loan-summary__item">
            <span class="loan-summary__number">@Model.Count(loan => loan.ReturnedOn == null)</span>
            <span class="loan-summary__label">Books out</span>
        </div>
        <div class="loan-summary__item loan-summary__item--alert">
            <span class="loan-summary__number">@Model.Count(loan => loan.Status == "Overdue")</span>
            <span class="loan-summary__label">Overdue</span>
        </div>
        <div class="loan-summary__item">
            <span class="loan-summary__number">@Model.Count(loan => loan.ReturnedOn != null)</span>
            <span class="loan-summary__label">Returned</span>
        </div>
    </div>

    <div class="loan-list">
        @foreach (var loan in Model)
        {
            <article class="loan-card">
                <div class="loan-card__main">
                    <div class="loan-card__bookmark" aria-hidden="true">▤</div>
                    <div class="loan-card__title-block">
                        <p class="loan-card__member">@loan.MemberName</p>
                        <h2 class="loan-card__title">@loan.BookTitle</h2>
                    </div>
                    <span class="loan-status @(loan.Status == "Overdue" ? "loan-status--overdue" : loan.Status == "Out" ? "loan-status--out" : "loan-status--returned")">@loan.Status</span>
                </div>
                <div class="loan-card__details">
                    <div>
                        <span class="loan-card__detail-label">Loaned</span>
                        <span class="loan-card__detail-value">@loan.LoanedOn.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div>
                        <span class="loan-card__detail-label">Due date</span>
                        <span class="loan-card__detail-value">@loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="loan-card__action">
                        @if (loan.ReturnedOn == null)
                        {
                            <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success"><span aria-hidden="true">✓</span> Return</button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</section>
